{
  "name": "interplanetaryfund-sandbox-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "wrangler dev --local --port 8787",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/*.test.ts",
    "test:browser": "playwright test",
    "deploy": "npm run check && wrangler deploy",
    "check": "npm run lint && npm run build && npm test",
    "types": "wrangler types"
  },
  "dependencies": {
    "lucide-react": "1.72.0",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "5.20261110.1",
    "@electric-sql/pglite": "0.5.16",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "wrangler": "4.160.0"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
