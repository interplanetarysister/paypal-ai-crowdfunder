{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ifund-hackathon-demo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-11",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "ai": { "binding": "AI", "remote": false },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "ifund-hackathon-demo-media",
      "remote": false,
    },
  ],
  "secrets_store_secrets": [
    {
      "binding": "PAYPAL_CLIENT_ID",
      "store_id": "73dd92b20b84400fab306a75568307a3",
      "secret_name": "Paypal_sandbox_app_id",
    },
    {
      "binding": "PAYPAL_CLIENT_SECRET",
      "store_id": "73dd92b20b84400fab306a75568307a3",
      "secret_name": "paypal_sandbox_app_secret",
    },
  ],
  "triggers": { "crons": ["*/30 * * * *"] },
  "observability": { "enabled": true, "redact_query_string": true, "traces": { "enabled": true } },
  "vars": {
    "DEMO_ENABLED": "false",
    "AI_ENABLED": "false",
    "DEMO_ORIGIN": "https://ifund-hackathon-demo.interplanetary-fund.workers.dev",
    "SUPABASE_URL": "https://ssibsfmtodgximseeqsv.supabase.co",
    "RELEASE_SHA": "NOT_DEPLOYED",
  },
}
