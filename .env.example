# Server bindings only. Never prefix secrets with VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=bind-through-cloudflare-secrets
PAYPAL_CLIENT_ID=sandbox-app-client-id
PAYPAL_CLIENT_SECRET=bind-through-cloudflare-secrets
PAYPAL_WEBHOOK_ID=existing-sandbox-webhook-id
PAYPAL_MERCHANT_ID=expected-sandbox-merchant-id
# Set in isolated Worker only after checking database and provider ownership.
DEMO_ENABLED=false
AI_ENABLED=false
DEMO_ORIGIN=https://YOUR_DEMO.workers.dev
RELEASE_SHA=NOT_DEPLOYED
